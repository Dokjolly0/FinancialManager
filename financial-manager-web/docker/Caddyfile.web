# Caddy inside the `web` image: serves the Angular build on :8080 to the
# host's Caddy, which terminates HTTPS and sets the security headers
# (financial-manager-backend/deploy/Caddyfile.example).
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	# The build names scripts, styles and fonts after a hash of their content
	# (main-XXXX.js, chunk-XXXX.js, styles-XXXX.css, media/*): a new deploy
	# gets new names, so these can be cached for a year without a check.
	@hashed path_regexp hashed ^/(?:(?:main|chunk|polyfills|styles)-[A-Za-z0-9_-]{8,}\.(?:js|css)|media/.+)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Everything else (index.html, i18n/*.json, the manifest, icons) keeps
	# its name across deploys: browsers revalidate it (ETag, cheap 304s), or
	# they would keep the old dashboard after an update.
	@unhashed not path_regexp ^/(?:(?:main|chunk|polyfills|styles)-[A-Za-z0-9_-]{8,}\.(?:js|css)|media/.+)$
	header @unhashed Cache-Control "no-cache"

	# Android verifies App Links against this file: it must be JSON, served
	# as is (never index.html) and without redirects.
	@assetlinks path /.well-known/assetlinks.json
	header @assetlinks Content-Type "application/json"

	# App routes (/app/history, /reset-password, ...) are not files:
	# index.html handles them (Angular's path routing).
	try_files {path} /index.html
	file_server
}
