# Site block for the host's Caddy (installed as a system service, config in
# /etc/caddy/Caddyfile). Append it next to the other sites, then:
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
# Caddy gets and renews the Let's Encrypt certificate by itself once the DNS
# record points at the VPS, and redirects http to https.
# See docs/build-deploy.md, "DNS e HTTPS".

financialmanager.alexviolatto.dev {
	# HTTPS only from now on, for a year (plan.md section 19.3). .dev is
	# HSTS-preloaded anyway.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# The API, published by compose.prod.yaml on 127.0.0.1:10003
	# (API_HOST_BIND=127.0.0.1). handle_path strips /api, so the backend keeps
	# its own routes (/v1/..., /health/...): the app's base URL is
	# https://financialmanager.alexviolatto.dev/api/v1.
	# Caddy sets X-Forwarded-For; the API trusts it only from
	# TRUSTED_PROXY_CIDRS.
	handle_path /api/* {
		# The API serves Prometheus metrics on /metrics without auth: they
		# must stay off the public internet (plan.md section 22.1). Inside
		# handle_path the /api prefix is already gone, and respond runs
		# before reverse_proxy. (A respond outside this block would never
		# run: Caddy orders handle_path before respond.)
		respond /metrics* 404

		reverse_proxy 127.0.0.1:10003 {
			# AI analyses stream as Server-Sent Events: send every chunk at
			# once. Caddy has no read timeout by default, so streams up to
			# AI_STREAM_MAX_DURATION are not cut.
			flush_interval -1
		}
	}

	# Everything else: the web dashboard, served by the `web` container
	# (compose.prod.yaml) on 127.0.0.1:10005, which also sends app routes
	# such as /app/history to index.html.
	handle {
		# The browser may only load the dashboard's own files, plus Google's
		# sign-in script/popup (GIS) and the fonts Flutter fetches for glyphs
		# it doesn't bundle. 'wasm-unsafe-eval' is for CanvasKit (WebAssembly);
		# 'unsafe-inline' styles because Flutter positions its elements with
		# style attributes. Images: any https (category pictures from search
		# providers), data: and blob: (picked files before upload).
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://accounts.google.com/gsi/ https://fonts.gstatic.com; frame-src https://accounts.google.com/gsi/; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
		}
		reverse_proxy 127.0.0.1:10005
	}
}
