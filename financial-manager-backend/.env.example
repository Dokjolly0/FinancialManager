# Copy to .env for local development. Never commit a real .env file.
# See plan.md section 10.5 for the full rationale behind each variable.

APP_ENV=local
HTTP_ADDR=:8080
# Upper bound for every request except the AI analysis streams, which use
# AI_STREAM_MAX_DURATION instead.
HTTP_REQUEST_TIMEOUT=30s

# Reverse proxies whose X-Forwarded-For header names the real client
# (comma-separated CIDRs or IPs). Leave empty when clients reach the API
# directly. In production the API sits behind the host's Caddy, which
# reaches the container through the Docker bridge: 172.16.0.0/12.
# Never list addresses the public can connect from, or anyone could spoof
# their IP. See docs/build-deploy.md, "DNS e HTTPS".
TRUSTED_PROXY_CIDRS=

# Browser origins allowed to call the API from another origin, comma
# separated (e.g. http://localhost:5000). Only for developing the web
# dashboard locally with `flutter run -d chrome --web-port 5000`; leave it
# empty in production, where the dashboard is on the API's own origin.
CORS_ALLOWED_ORIGINS=

# Only used by the worker process (the API exposes /metrics on HTTP_ADDR
# itself, alongside its regular routes) — plan.md section 22.1.
METRICS_ADDR=:9101

# Host-mapped ports for local development default to the plan's range and are
# used by Docker Compose. Change these when multiple stacks share the same host.
# If you run Go directly on the host, keep DATABASE_URL/REDIS_ADDR/
# OBJECT_STORAGE_ENDPOINT below in sync with these values.
POSTGRES_HOST_PORT=10001
REDIS_HOST_PORT=10002
API_HOST_PORT=10003
OBJECT_STORAGE_HOST_PORT=10004
# Production (compose.prod.yaml) publishes only the API, on
# API_HOST_BIND:API_HOST_PORT. Behind a reverse proxy on the same host use
# 127.0.0.1 so port 10003 is not reachable from outside.
# API_HOST_BIND=127.0.0.1

# Web dashboard (service `web`, compose.prod.yaml only): host port on
# 127.0.0.1 that the host's Caddy proxies to, and the tag of the
# dokjolly/financial-manager-web image built by CI (latest, or
# sha-<commit> to pin a version for a rollback). The API URL is compiled
# into the image by CI. See docs/build-deploy.md, "Dashboard web".
# WEB_HOST_PORT=10005
# WEB_IMAGE_TAG=latest

# Inside the Docker network, services address each other by service name and
# internal port; the localhost addresses below are for host-run tools/processes.
DATABASE_URL=postgres://financial_manager:financial_manager@localhost:10001/financial_manager?sslmode=disable

REDIS_ADDR=localhost:10002
REDIS_PASSWORD=

OBJECT_STORAGE_ENDPOINT=localhost:10004
OBJECT_STORAGE_BUCKET=financial-manager-media
OBJECT_STORAGE_ACCESS_KEY=financial_manager
OBJECT_STORAGE_SECRET_KEY=financial_manager_secret
OBJECT_STORAGE_USE_SSL=false

# Comma-separated list of Google OAuth client IDs allowed as token audience.
# Leave empty in local/test until real client IDs are provisioned; Google
# sign-in requests will be rejected until this is set (see plan.md section 15.2).
GOOGLE_CLIENT_IDS=

# Required in production; local/test fall back to an insecure dev default.
JWT_SIGNING_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# "stub" (default) uses a fake in-memory provider for local/test so the
# media search feature is exercisable without external credentials.
# "unsplash" requires IMAGE_SEARCH_API_KEY from unsplash.com/developers.
IMAGE_SEARCH_PROVIDER=stub
IMAGE_SEARCH_API_KEY=

MAX_UPLOAD_BYTES=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Off-site backups to Google Drive, run by the worker (docs/backup-restore.md).
# Defaults to false here and to true under compose.prod.yaml. When enabled,
# BACKUP_ENCRYPTION_KEY and the three GDRIVE_* values are required; if any is
# missing the worker keeps running its other jobs and logs backup_not_configured.
BACKUP_ENABLED=false
# Generate with `openssl rand -base64 48` and keep a copy outside the server:
# without it the backups on Drive cannot be decrypted.
BACKUP_ENCRYPTION_KEY=
BACKUP_INTERVAL=24h
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_MONTHS=12
BACKUP_INCLUDE_MEDIA=true
BACKUP_GDRIVE_FOLDER_NAME=FinancialManager Backups
# OAuth client of type "Desktop app" from Google Cloud Console, plus the
# refresh token printed by:
#   go run ./cmd/gdrive-auth -client-id ... -client-secret ...
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=

# AI analysis (plan.md section 32). Every user brings their own provider API
# key; this key encrypts those keys at rest (AES-256-GCM). Leave it empty to
# disable the feature. Generate with `openssl rand -base64 32` and keep a
# copy: losing it means every user has to enter their API key again.
AI_KEY_ENCRYPTION_KEY=
# Set to the old key while rotating AI_KEY_ENCRYPTION_KEY; stored keys are
# re-encrypted with the new one the next time they are used.
AI_KEY_ENCRYPTION_KEY_PREVIOUS=
# Let "OpenAI-compatible" base URLs reach private/loopback addresses over
# http (e.g. Ollama on the LAN). Keep false on a server reachable by others.
AI_ALLOW_PRIVATE_BASE_URLS=false
# Optional comma-separated allowlist of hosts for OpenAI-compatible base URLs.
AI_ALLOWED_BASE_URL_HOSTS=
AI_STREAM_MAX_DURATION=5m
AI_STREAM_IDLE_TIMEOUT=90s
AI_MAX_PROMPT_TOKENS=60000
AI_RUNS_PER_HOUR=20
# On-device analysis: the model runs on the user's phone (Android) and the
# server only builds the prompt and stores the history. Works without
# AI_KEY_ENCRYPTION_KEY. AI_LOCAL_MAX_DURATION is how long a phone may take
# to finish a report before it is shown as interrupted.
AI_ON_DEVICE_ENABLED=true
AI_LOCAL_RUNS_PER_HOUR=30
AI_LOCAL_MAX_DURATION=30m
