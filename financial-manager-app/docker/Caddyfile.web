# Caddy inside the `web` image: serves the Flutter web build on :8080 to
# the host's Caddy, which terminates HTTPS and sets the security headers
# (financial-manager-backend/deploy/Caddyfile.example).
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	# Flutter's file names carry no content hash (main.dart.js, assets,
	# canvaskit): browsers must revalidate everything (ETag, cheap 304s),
	# or they would keep the old dashboard after a deploy.
	header Cache-Control "no-cache"

	# App routes (/app/history, ...) are not files: index.html handles
	# them (usePathUrlStrategy).
	try_files {path} /index.html
	file_server
}
